# Copy this file to .env and fill in your key
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for SQL generation and judging
LLM_MODEL=gemini-3.5-flash-lite

# Optional: Connection string to use a custom database (SQLite, PostgreSQL, MySQL, etc.)
# If set, this overrides DB_PATH and skips bootstrapping the demo Chinook tables.
# Examples:
# DATABASE_URL=sqlite:///data/my_database.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/my_database
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/my_database
# DATABASE_URL=

# Path to the default DuckDB database file (used if DATABASE_URL is not set)
DB_PATH=data/chinook.duckdb

# Max rows returned per query (safety limit)
MAX_ROWS=200
